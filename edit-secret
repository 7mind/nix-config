#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") SECRET.age" >&2
}

if [[ "$#" -ne 1 ]]; then
    usage
    exit 2
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$REPO_ROOT/private/setup-env" ]]; then
    # setup-env populates this array for setup; the editor only needs its path overrides.
    # shellcheck disable=SC2034
    declare -A group_pubkeys=()
    set +u
    # shellcheck source=/dev/null
    source "$REPO_ROOT/private/setup-env"
    set -u
fi

AGE_TPM_IDENTITY="${AGE_TPM_IDENTITY:-${HOME}/.age/tpm-identity.txt}"
AGE_MASTER_KEY_TPM="${AGE_MASTER_KEY_TPM:-${HOME}/.age/master-key.age}"
if [[ "$(uname)" == "Darwin" ]]; then
    AGE_RUNTIME_KEY="${AGE_RUNTIME_KEY:-/tmp/age-master-key}"
else
    AGE_RUNTIME_KEY="${AGE_RUNTIME_KEY:-/dev/shm/age-master-key}"
fi
AGE_RUNTIME_LOCK="${AGE_RUNTIME_KEY}.lock"
AGE_COMPATIBILITY_KEY=""
AGE_COMPATIBILITY_LOCK=""
if [[ "$(uname)" != "Darwin" && "$AGE_RUNTIME_KEY" != "/tmp/age-master-key" ]]; then
    AGE_COMPATIBILITY_KEY="/tmp/age-master-key"
    AGE_COMPATIBILITY_LOCK="${AGE_COMPATIBILITY_KEY}.lock"
fi
PASSWORD_KEY="${HOME}/age-key.age"
RUNTIME_KEY_CREATED=0
LOCK_CREATED=0
COMPATIBILITY_KEY_CREATED=0
COMPATIBILITY_LOCK_CREATED=0

cleanup() {
    if [[ "$COMPATIBILITY_KEY_CREATED" -eq 1 ]]; then
        rm -f -- "$AGE_COMPATIBILITY_KEY"
    fi
    if [[ "$RUNTIME_KEY_CREATED" -eq 1 ]]; then
        rm -f -- "$AGE_RUNTIME_KEY"
    fi
    if [[ "$COMPATIBILITY_LOCK_CREATED" -eq 1 ]]; then
        rmdir -- "$AGE_COMPATIBILITY_LOCK"
    fi
    if [[ "$LOCK_CREATED" -eq 1 ]]; then
        rmdir -- "$AGE_RUNTIME_LOCK"
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for command_name in age age-keygen agenix; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "Error: required command not found: $command_name" >&2
        exit 1
    fi
done

if ! mkdir -- "$AGE_RUNTIME_LOCK"; then
    echo "Error: another secret operation holds $AGE_RUNTIME_LOCK" >&2
    exit 1
fi
LOCK_CREATED=1

if [[ -n "$AGE_COMPATIBILITY_LOCK" ]]; then
    if ! mkdir -- "$AGE_COMPATIBILITY_LOCK"; then
        echo "Error: another secret operation holds $AGE_COMPATIBILITY_LOCK" >&2
        exit 1
    fi
    COMPATIBILITY_LOCK_CREATED=1
fi

if [[ -e "$AGE_RUNTIME_KEY" ]]; then
    echo "Error: refusing to replace existing runtime key: $AGE_RUNTIME_KEY" >&2
    exit 1
fi
if [[ -n "$AGE_COMPATIBILITY_KEY" && -e "$AGE_COMPATIBILITY_KEY" ]]; then
    echo "Error: refusing to replace existing compatibility path: $AGE_COMPATIBILITY_KEY" >&2
    exit 1
fi

RUNTIME_KEY_CREATED=1
umask 077
if [[ "$(uname)" != "Darwin" && -f "$AGE_MASTER_KEY_TPM" && -f "$AGE_TPM_IDENTITY" ]]; then
    if ! command -v age-plugin-tpm >/dev/null 2>&1; then
        echo "Error: required command not found: age-plugin-tpm" >&2
        exit 1
    fi
    age -d -i "$AGE_TPM_IDENTITY" -o "$AGE_RUNTIME_KEY" "$AGE_MASTER_KEY_TPM"
elif [[ -f "$PASSWORD_KEY" ]]; then
    age -d -o "$AGE_RUNTIME_KEY" "$PASSWORD_KEY"
else
    echo "Error: no usable master identity found." >&2
    echo "Expected TPM files $AGE_MASTER_KEY_TPM and $AGE_TPM_IDENTITY," >&2
    echo "or password-protected key $PASSWORD_KEY." >&2
    exit 1
fi
chmod 600 "$AGE_RUNTIME_KEY"

if [[ -n "$AGE_COMPATIBILITY_KEY" ]]; then
    ln -s -- "$AGE_RUNTIME_KEY" "$AGE_COMPATIBILITY_KEY"
    COMPATIBILITY_KEY_CREATED=1
fi

AGENIX_REKEY_PRIMARY_IDENTITY="$(age-keygen -y "$AGE_RUNTIME_KEY")"
AGENIX_REKEY_PRIMARY_IDENTITY_ONLY=true
export AGENIX_REKEY_PRIMARY_IDENTITY
export AGENIX_REKEY_PRIMARY_IDENTITY_ONLY

cd "$REPO_ROOT"
agenix edit "$1"
