#!/usr/bin/env bash

set -xe

function workdir() {
    ORIGIN="$(cd -- "${NIX_CONFIG_FLAKE_DIR:-$(dirname -- "${BASH_SOURCE[0]}")}" && pwd -P)"
    pushd .
    cd "$ORIGIN"
}

function add_all() {
    git add .
    git submodule foreach git add .
}

workdir
add_all

git submodule foreach git commit -am "autosave" || true
git commit -am "autosave" || true

sudo nixos-rebuild switch --flake "${PWD}" "$@"

popd
