JSON Schema patterns commonly contain ECMAScript shorthand character
classes. Passing those escapes through verbatim produces invalid GBNF and
causes llama-server to reject the entire tool set.

Upstream: https://github.com/ggml-org/llama.cpp/issues/27580

diff --git a/common/json-schema-to-grammar.cpp b/common/json-schema-to-grammar.cpp
index b18607cd..aa8135e5 100644
--- a/common/json-schema-to-grammar.cpp
+++ b/common/json-schema-to-grammar.cpp
@@ -283,0 +284,25 @@ static std::unordered_set<char> ESCAPED_IN_REGEXPS_BUT_NOT_IN_LITERALS = {'^', '
+static const char * regex_shorthand_rule(char shorthand) {
+    switch (shorthand) {
+        case 'd': return "[0-9]";
+        case 'D': return "[^0-9]";
+        case 'w': return "[0-9A-Za-z_]";
+        case 'W': return "[^0-9A-Za-z_]";
+        case 's': return "[ \\t\\r\\n\\x0B\\x0C]";
+        case 'S': return "[^ \\t\\r\\n\\x0B\\x0C]";
+        default:  return nullptr;
+    }
+}
+
+static const char * regex_shorthand_range(char shorthand) {
+    switch (shorthand) {
+        case 'd': return "0-9";
+        case 'w': return "0-9A-Za-z_";
+        case 's': return " \\t\\r\\n\\x0B\\x0C";
+        default:  return nullptr;
+    }
+}
+
+static bool is_negated_regex_shorthand(char shorthand) {
+    return shorthand == 'D' || shorthand == 'W' || shorthand == 'S';
+}
+
