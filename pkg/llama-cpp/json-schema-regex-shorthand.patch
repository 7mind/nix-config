+static const char * regex_shorthand_rule(char shorthand) {
+    switch (shorthand) {
+        case 'd': return "[0-9]";
+        case 'D': return "[^0-9]";
+        case 'w': return "[0-9A-Za-z_]";
+        case 'W': return "[^0-9A-Za-z_]";
+        case 's': return "[ \\t\\r\\n\\x0B\\x0C]";
+        case 'S': return "[^ \\t\\r\\n\\x0B\\x0C]";
+        default:  return nullptr;
+    }
+}
+
+static const char * regex_shorthand_range(char shorthand) {
+    switch (shorthand) {
+        case 'd': return "0-9";
+        case 'w': return "0-9A-Za-z_";
+        case 's': return " \\t\\r\\n\\x0B\\x0C";
+        default:  return nullptr;
+    }
+}
+
+static bool is_negated_regex_shorthand(char shorthand) {
+    return shorthand == 'D' || shorthand == 'W' || shorthand == 'S';
+}
