+// Reattach without hanging up the old peer, so its queued ACK remains readable.
+func (s *link390Sim) reattachAfterACK(path string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.advanceGeneration()
+	s.hid = path
+}
