diff --git a/internal/firmware/control_hidraw_test.go b/internal/firmware/control_hidraw_test.go
index 06cf1eb..e59bb80 100644
--- a/internal/firmware/control_hidraw_test.go
+++ b/internal/firmware/control_hidraw_test.go
@@ -2,9 +2,51 @@ package firmware
 
 import (
 	"bytes"
+	"os"
 	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
 )
 
+// hidraw can signal both a pending input report and disconnection. The
+// production transport treats this as a lost ACK, not proof of a reset.
+func TestControlReadTreatsQueuedACKOnHangupAsDisconnect(t *testing.T) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_SEQPACKET|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	host := os.NewFile(uintptr(fds[0]), "host")
+	peer := os.NewFile(uintptr(fds[1]), "peer")
+	defer host.Close()
+	defer peer.Close()
+	layout, err := SelectControlLayout(managementReports(GnpReportID, 64))
+	if err != nil {
+		t.Fatal(err)
+	}
+	transport := &ControlHidraw{file: host, Layout: layout}
+	ack := []byte{GnpReportID, 0, GnpSrcDongle, 0x31, 0xc6, 0xff, 0}
+	if _, err := peer.Write(ack); err != nil {
+		t.Fatal(err)
+	}
+	if packet, err := transport.Read(time.Second); err != nil || !bytes.Equal(packet, ack) {
+		t.Fatalf("connected ACK: packet %x, error %v", packet, err)
+	}
+	if _, err := peer.Write(ack); err != nil {
+		t.Fatal(err)
+	}
+	if err := peer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	poll := []unix.PollFd{{Fd: int32(fds[0]), Events: unix.POLLIN}}
+	if n, err := unix.Poll(poll, 0); err != nil || n != 1 || poll[0].Revents&(unix.POLLIN|unix.POLLHUP) != unix.POLLIN|unix.POLLHUP {
+		t.Fatalf("expected readable input plus hangup: %+v, error %v", poll, err)
+	}
+	if packet, err := transport.Read(time.Second); packet != nil || err == nil || err.Error() != "management device disconnected" {
+		t.Fatalf("disconnected ACK: packet %x, error %v", packet, err)
+	}
+}
+
 func managementReports(id byte, size int) []HIDReport {
 	field := HIDField{SizeBits: 8, Count: uint32(size - 1), UsagePage: 0xff00, Usages: []uint32{1}, Flags: 0x102}
 	return []HIDReport{{ID: id, Kind: "input", Bytes: size, Fields: []HIDField{field}}, {ID: id, Kind: "output", Bytes: size, Fields: []HIDField{field}}}
