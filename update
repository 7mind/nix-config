#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s [--dry-run]\n' "$0"
}

dry_run=false
case "${1-}" in
  "") ;;
  --dry-run) dry_run=true ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if (( $# > 1 )); then
  usage >&2
  exit 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
workspace_dir=$(dirname -- "$script_dir")

declare -a repositories=()
declare -a repositories_to_push=()

add_repository() {
  local repository=$1
  local existing
  local root

  root=$(git -C "$repository" rev-parse --show-toplevel 2>/dev/null) || return 0
  [[ "$root" == "$repository" ]] || return 0
  for existing in "${repositories[@]}"; do
    [[ "$existing" == "$repository" ]] && return 0
  done
  repositories+=("$repository")
}

if [[ -f "$script_dir/.gitmodules" ]]; then
  while IFS= read -r -d '' record; do
    submodule_path=${record#*$'\n'}
    add_repository "$script_dir/$submodule_path"
  done < <(git -C "$script_dir" config -z --file .gitmodules --get-regexp '^submodule\..*\.path$' || true)
fi

for candidate in "$workspace_dir"/*; do
  [[ -f "$candidate/flake.nix" ]] || continue
  add_repository "$candidate"
done

for repository in "${repositories[@]}"; do
  name=${repository#"$workspace_dir"/}
  branch=$(git -C "$repository" symbolic-ref --quiet --short HEAD) || {
    printf 'skip %-24s detached HEAD\n' "$name"
    continue
  }
  upstream=$(git -C "$repository" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || {
    printf 'skip %-24s %s has no upstream\n' "$name" "$branch"
    continue
  }
  read -r behind ahead < <(git -C "$repository" rev-list --left-right --count "$upstream...HEAD")
  if (( behind > 0 && ahead > 0 )); then
    printf 'error: %s has diverged from %s (%d behind, %d ahead)\n' "$name" "$upstream" "$behind" "$ahead" >&2
    exit 1
  fi
  if (( ahead == 0 )); then
    printf 'skip %-24s nothing to push\n' "$name"
    continue
  fi
  if [[ -n $(git -C "$repository" status --porcelain) ]]; then
    printf 'note %-24s pushing %d committed change(s); uncommitted changes stay local\n' "$name" "$ahead"
  else
    printf 'push %-24s %d commit(s) to %s\n' "$name" "$ahead" "$upstream"
  fi
  repositories_to_push+=("$repository")
done

for repository in "${repositories_to_push[@]}"; do
  name=${repository#"$workspace_dir"/}
  if [[ "$dry_run" == true ]]; then
    printf 'dry  %-24s git push\n' "$name"
  else
    git -C "$repository" push
  fi
done

if [[ "$dry_run" == true ]]; then
  printf 'dry  nix-config               nix flake update\n'
else
  cd -- "$script_dir"
  nix flake update
fi
