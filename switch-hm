#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [HOST] [-- EXTRA_ARGS...]

Switch a standalone Home Manager configuration, locally or over SSH.
HOST and USER default to the switching machine's short hostname and login user.
The configuration is USER@HOST-ARCH (USER@HOST-ARCH-darwin on macOS).
HOST selects the profile; --target-host selects the remote SSH destination.

Options:
      --flake-dir DIR
                    Use another flake checkout (default: this script's checkout)
  -u, --user USER    Override the configuration's username
  -t, --target-host [USER@]HOST
                    Build locally, copy the closure and activate over SSH
      --use-remote-sudo
                    Use sudo -n for remote store imports, never activation
      --dry-run     Remote build preview only; no rekey, copy, activation, commit or push
      --rekey       Rekey only the selected profile locally before activation
                    Reuse runtime keys or unlock existing local TPM enrollment
  -l, --list         List available Home Manager configurations and exit
  -n, --no-git       Skip git commit and push (changes are still staged for Nix)
  -np, --no-push     Commit locally but skip git push
  -m, --message MSG  Custom commit message (default: "autosave", no host/user names)
  -h, --help         Show this help

Enters the selected checkout's pinned development shell automatically, like setup.
Uses its pinned Home Manager CLI and hmbak backup extension.
Git operations cover the selected checkout and its initialized submodules.
Commits and pushes happen only after a successful switch. No upstream sync
is performed; custom commit messages are used verbatim.

Remote mode requires installed Nix (SSH PATH or standard profile) and an existing SSH login.
Only the selected activation closure is copied; the checkout is not synchronized. Remote
username/home directory must match the selected profile. The target needs no
checkout. Cross-platform builds need a configured builder or cached outputs.
Extra args go to Home Manager locally, or both nix eval and nix build remotely
(use options accepted by both commands). NIX_SSHOPTS (single-line, space/tab-separated
SSH arguments, without shell quoting) applies to remote connections; SSH config
supports aliases, ports and identity files. Dry runs still stage source files.
With --rekey, extra args must also be accepted by nix eval and nix run (for
example --override-input); they must also be accepted by nix develop for shell
bootstrap. The same inputs are used for rekey and activation.
Rekey failures abort activation; closed stdin prevents retries or dummy choices.
On Linux, a missing runtime key is unlocked through existing TPM enrollment.
No enrollment or password-backup fallback is performed. Keys created by this
script are removed after rekey, including on failure; pre-existing keys are kept.
EOF
}

fail() {
    printf 'switch-hm: %s\n' "$*" >&2
    exit 1
}

commit_changes() {
    local message="$1" status
    git add -A
    if git diff --cached --quiet; then
        return 0
    else
        status=$?
    fi
    [[ "$status" == 1 ]] || return "$status"
    git commit -m "$message"
}

stage_changes() {
    # Nix's Git flake source includes new files only after they enter the index.
    git submodule foreach 'git add -A'
    git add -A
}

configuration_arch() {
    local arch="$1" platform="$2"
    [[ "$arch" != arm64 ]] || arch=aarch64
    case "$platform" in
        Linux) ;;
        Darwin) arch+="-darwin" ;;
        *) fail "unsupported platform: $platform" ;;
    esac
    printf '%s\n' "$arch"
}

rekey_home() {
    local profile="$1" metadata value directory identity system canonical_runtime checkout
    local unlock_dir="" runtime_key="${AGE_RUNTIME_KEY:-/dev/shm/age-master-key}"
    local command_pid="" grouped_child=false lock_fd
    local tpm_identity="${AGE_TPM_IDENTITY:-$HOME/.age/tpm-identity.txt}"
    local tpm_ciphertext="${AGE_MASTER_KEY_TPM:-$HOME/.age/master-key.age}"
    shift
    local -a info=()
    cleanup_master_identity() {
        local status="$1"
        trap '' HUP INT TERM
        if [[ -n "$command_pid" ]]; then
            if [[ "$grouped_child" == true ]]; then
                kill -TERM -- "-$command_pid" 2>/dev/null || :
            else
                kill -TERM "$command_pid" 2>/dev/null || :
            fi
            wait "$command_pid" 2>/dev/null || :
        fi
        if [[ -n "$unlock_dir" ]]; then
            if [[ "$unlock_dir/key" -ef "$runtime_key" ]]; then
                rm -f -- "$runtime_key" || status=$?
            fi
            rm -f -- "$unlock_dir/key" || status=$?
            rmdir -- "$unlock_dir" || status=$?
        fi
        exit "$status"
    }
    set -E
    trap 'exit "$?"' ERR
    trap 'cleanup_master_identity "$?"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    run_key_command() {
        local status=0
        if [[ "$system" == *-linux ]]; then
            grouped_child=true
            setsid "$@" </dev/null &
        else
            grouped_child=false
            "$@" </dev/null &
        fi
        command_pid=$!
        wait "$command_pid" || status=$?
        command_pid=""
        return "$status"
    }
    metadata="$(nix --extra-experimental-features 'nix-command flakes' eval \
        --no-write-lock-file --raw ".?submodules=1#homeConfigurations.\"${profile}\".config.age" \
        --apply 'age:
            assert age.enable;
            assert age.rekey.storageMode == "local";
            assert age.rekey.masterIdentities != [];
            builtins.concatStringsSep "\n" (
                [ (toString age.rekey.localStorageDir) ] ++
                map (key: toString key.identity) age.rekey.masterIdentities
            )' "$@")"
    while IFS= read -r value; do info+=("$value"); done <<< "$metadata"
    [[ ${#info[@]} -ge 2 ]] || fail 'unexpected rekey metadata output'
    [[ "${info[0]}" =~ ^/nix/store/[^/]+/((private/)?secrets/rekeyed/[a-zA-Z0-9._-]+)$ ]] \
        || fail 'rekey storage must be a profile directory under private/secrets/rekeyed or secrets/rekeyed'
    directory="${BASH_REMATCH[1]}"
    [[ "${directory##*/}" != . && "${directory##*/}" != .. ]] \
        || fail 'rekey storage must not escape its profile directory'
    system="$(configuration_arch "$(uname -m)" "$(uname -s)")"
    [[ "$system" == *-darwin ]] || system+="-linux"
    if [[ "$system" == *-linux ]]; then
        command -v setsid >/dev/null || fail 'setsid is required for rekey cancellation; reload the development shell'
        for identity in "${info[@]:1}"; do
            [[ "$identity" == "$runtime_key" ]] || continue
            canonical_runtime="$(realpath -m -- "$runtime_key")"
            checkout="$(pwd -P)"
            [[ "$canonical_runtime" != "$checkout" && "$canonical_runtime" != "$checkout/"* ]] \
                || fail 'TPM runtime identity must be outside the checkout to avoid staging plaintext'
            command -v flock >/dev/null || fail 'flock is required to serialize runtime-key use; reload the development shell'
            exec {lock_fd}>> "$runtime_key.lock"
            flock -n "$lock_fd" || fail 'runtime master identity is already in use by another switch; retry when it finishes'
            break
        done
    fi
    for identity in "${info[@]:1}"; do
        if [[ -f "$identity" && -r "$identity" ]]; then
            continue
        fi
        [[ ! -e "$identity" && ! -L "$identity" ]] \
            || fail "master identity is not readable: $identity"
        [[ "$system" == *-linux && "$identity" == "$runtime_key" ]] \
            || fail "master identity is not readable: $identity; unlock this configured identity explicitly"
        [[ -f "$tpm_identity" && -r "$tpm_identity" && -f "$tpm_ciphertext" && -r "$tpm_ciphertext" ]] \
            || fail "master identity is not readable: $identity; TPM enrollment is missing or unreadable; run ./enroll-tpm with your existing master-key backup first"
        command -v age >/dev/null || fail 'age is required for TPM unlock; reload the development shell'
        command -v age-plugin-tpm >/dev/null || fail 'age-plugin-tpm is required for TPM unlock; reload the development shell'
        printf 'switch-hm: unlocking master identity through existing local TPM enrollment\n' >&2
        umask 077
        unlock_dir="$(mktemp -d "${runtime_key}.unlock.XXXXXXXX")"
        run_key_command age -d -i "$tpm_identity" -o "$unlock_dir/key" "$tpm_ciphertext"
        chmod 600 "$unlock_dir/key"
        # Keep an inode reference for cleanup; never replace another process's key.
        ln -T -- "$unlock_dir/key" "$runtime_key"
    done
    AGENIX_REKEY_ADD_TO_GIT=false run_key_command nix --extra-experimental-features 'nix-command flakes' run \
        --no-write-lock-file ".?submodules=1#agenix-rekey-homes.\"${profile}\".${system}.rekey" "$@" </dev/null
    if [[ "$directory" == private/* ]]; then
        git -C private add -A -- "${directory#private/}"
    else
        git add -A -- "$directory"
    fi
    exit 0
}

run_rekey_home() {
    local worker_pid="" status=0
    stop_rekey_worker() {
        local status="$1" pid="${worker_pid:-${!:-}}"
        trap '' HUP INT TERM
        if [[ -n "$pid" ]]; then
            kill -TERM "$pid" 2>/dev/null || :
            wait "$pid" 2>/dev/null || :
        fi
        exit "$status"
    }
    trap 'stop_rekey_worker 129' HUP
    trap 'stop_rekey_worker 130' INT
    trap 'stop_rekey_worker 143' TERM
    rekey_home "$@" &
    worker_pid=$!
    wait "$worker_pid" || status=$?
    trap - HUP INT TERM
    return "$status"
}

uri_encode() {
    local value="$1" char i LC_ALL=C
    for ((i = 0; i < ${#value}; i++)); do
        char="${value:i:1}"
        case "$char" in
            [a-zA-Z0-9.~_-]) printf '%s' "$char" ;;
            *) printf '%%%02X' "'$char" ;;
        esac
    done
}

switch_remote() {
    local target="$1" host="$2" username="$3" use_sudo="$4" dry_run="$5" ssh_opts="$6" do_rekey="$7"
    shift 7
    local info value arch selector home_info activation importer destination
    local -a remote_info=() extra_ssh_options=()
    case "$ssh_opts" in
        *$'\n'*|*$'\r'*) fail 'NIX_SSHOPTS must be a single line of space/tab-separated SSH arguments' ;;
    esac
    read -r -a extra_ssh_options <<< "$ssh_opts"
    info="$(ssh -T -o BatchMode=yes "${extra_ssh_options[@]}" -- "$target" sh -s <<'REMOTE'
set -eu
username=$(id -un)
hostname=$(hostname -s)
architecture=$(uname -m)
platform=$(uname -s)
if nix_store=$(command -v nix-store); then
    :
else
    for candidate in "$HOME/.nix-profile/bin/nix-store" /nix/var/nix/profiles/default/bin/nix-store; do
        if [ -x "$candidate" ]; then nix_store=$candidate; break; fi
    done
    if [ -z "$nix_store" ]; then
        printf 'switch-hm: Nix is not installed or discoverable on the target\n' >&2
        exit 1
    fi
    printf 'switch-hm: Nix is not on the SSH PATH; using %s\n' "$nix_store" >&2
fi
printf '%s\n' "$username" "$hostname" "$architecture" "$platform" "$HOME" "$nix_store"
REMOTE
)"
    while IFS= read -r value; do remote_info+=("$value"); done <<< "$info"
    [[ ${#remote_info[@]} == 6 ]] || fail 'unexpected remote metadata output'
    [[ "${remote_info[4]}" == /* && "${remote_info[5]}" == /* ]] || fail 'remote home and nix-store paths must be absolute'
    [[ -n "$host" ]] || host="${remote_info[1]}"
    [[ -n "$username" ]] || username="${remote_info[0]}"
    [[ "$host" =~ ^[[:alnum:]_][[:alnum:]_.-]*$ ]] || fail 'invalid hostname'
    [[ "$username" =~ ^[[:alnum:]_][[:alnum:]_.-]*$ ]] || fail 'invalid username'
    arch="$(configuration_arch "${remote_info[2]}" "${remote_info[3]}")"
    selector="homeConfigurations.\"${username}@${host}-${arch}\""
    stage_changes
    home_info="$(nix --extra-experimental-features 'nix-command flakes' eval \
        --no-write-lock-file --raw ".?submodules=1#${selector}.config.home" \
        --apply 'home: home.username + "\n" + home.homeDirectory' "$@")"
    [[ "$home_info" == "${remote_info[0]}"$'\n'"${remote_info[4]}" ]] \
        || fail 'selected profile username/home directory does not match the remote login'
    if [[ "$dry_run" == true ]]; then
        [[ "$do_rekey" == false ]] || printf 'switch-hm: dry run; not rekeying\n' >&2
        nix --extra-experimental-features 'nix-command flakes' build --dry-run --no-link \
            ".?submodules=1#${selector}.activationPackage" "$@"
        return 0
    fi
    if [[ "$do_rekey" == true ]]; then
        run_rekey_home "${username}@${host}-${arch}" "$@"
    fi
    activation="$(nix --extra-experimental-features 'nix-command flakes' build --no-link --print-out-paths \
        "$@" ".?submodules=1#${selector}.activationPackage")"
    [[ "$activation" =~ ^/nix/store/[0-9a-z]{32}-[a-zA-Z0-9+._?=-]+$ ]] || fail 'expected exactly one activation store path'
    importer="'${remote_info[5]//\'/\'\\\'\'}'"
    [[ "$use_sudo" == false ]] || importer="sudo -n $importer"
    destination="ssh://${target}?remote-program=$(uri_encode "$importer")"
    NIX_SSHOPTS="-o BatchMode=yes $ssh_opts" nix --extra-experimental-features 'nix-command flakes' copy \
        --substitute-on-destination --to "$destination" "$activation"
    ssh -n -T -o BatchMode=yes "${extra_ssh_options[@]}" -- "$target" \
        "HOME_MANAGER_BACKUP_EXT=hmbak '$activation/activate'"
}

rekey_tools_available() {
    command -v age >/dev/null && command -v age-plugin-tpm >/dev/null && {
        [[ "$(uname -s)" != Linux ]] || {
            command -v setsid >/dev/null && command -v flock >/dev/null
        }
    }
}

main() {
    local repo script caller_cwd host="" username="" message="autosave" target=""
    local do_git=true do_push=true do_list=false use_remote_sudo=false dry_run=false do_rekey=false
    local -a hm_args=() original_args=("$@") develop_args=()
    repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    script="$repo/${BASH_SOURCE[0]##*/}"
    caller_cwd="$(pwd -P)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --flake-dir)
                [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || fail '--flake-dir requires a directory'
                repo="$2"
                shift 2
                ;;
            --flake-dir=*)
                repo="${1#*=}"
                [[ -n "$repo" ]] || fail '--flake-dir requires a directory'
                shift
                ;;
            -u|--user)
                [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || fail '--user requires a username'
                username="$2"
                shift 2
                ;;
            --user=*)
                username="${1#*=}"
                [[ -n "$username" ]] || fail '--user requires a username'
                shift
                ;;
            -t|--target-host)
                [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || fail '--target-host requires an SSH destination'
                target="$2"
                shift 2
                ;;
            --target-host=*)
                target="${1#*=}"
                [[ -n "$target" ]] || fail '--target-host requires an SSH destination'
                shift
                ;;
            --use-remote-sudo) use_remote_sudo=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            --rekey) do_rekey=true; shift ;;
            -l|--list) do_list=true; shift ;;
            -n|--no-git) do_git=false; shift ;;
            -np|--no-push) do_push=false; shift ;;
            -m|--message)
                [[ $# -ge 2 && -n "$2" ]] || fail '--message requires a non-empty message'
                message="$2"
                shift 2
                ;;
            --message=*|-m=*)
                message="${1#*=}"
                [[ -n "$message" ]] || fail '--message requires a non-empty message'
                shift
                ;;
            -h|--help) usage; return 0 ;;
            --) shift; hm_args=("$@"); break ;;
            -*) fail "unknown option: $1 (use --help)" ;;
            *)
                [[ -z "$host" && -n "$1" ]] || fail 'expected at most one hostname'
                host="$1"
                shift
                ;;
        esac
    done

    if [[ -n "$target" ]]; then
        [[ "$target" =~ ^([[:alnum:]_][[:alnum:]_.-]*@)?[[:alnum:]_][[:alnum:]_.-]*$ ]] || fail 'invalid SSH destination; use [USER@]HOST or an SSH alias'
        [[ "$do_list" == false ]] || fail '--target-host cannot be combined with --list'
    else
        [[ "$use_remote_sudo" == false && "$dry_run" == false ]] || fail '--use-remote-sudo and --dry-run require --target-host'
    fi

    repo="$(cd -- "$repo" && pwd -P)"
    if [[ "$do_list" == true ]]; then
        [[ "$do_rekey" == false ]] || fail '--rekey cannot be combined with --list'
        cd -- "$repo"
        nix --extra-experimental-features 'nix-command flakes' eval \
            --no-write-lock-file --raw '.?submodules=1#homeConfigurations' \
            --apply 'configs: builtins.concatStringsSep "" (map (name: name + "\n") (builtins.attrNames configs))'
        return 0
    fi

    cd -- "$repo"
    local needs_dev_shell=false
    [[ "${NIX_CONFIG_DEV_SHELL:-}" == 1 ]] || needs_dev_shell=true
    if [[ "$do_rekey" == true ]] && ! rekey_tools_available; then
        needs_dev_shell=true
    fi
    if [[ "$needs_dev_shell" == true ]]; then
        [[ "${SWITCH_HM_DEV_SHELL_REEXEC:-}" != 1 ]] \
            || fail 'development shell still lacks required rekey tools; check the flake development-shell packages'
        [[ "$do_rekey" == false ]] || develop_args=("${hm_args[@]}")
        exec nix --extra-experimental-features 'nix-command flakes' develop \
            --no-write-lock-file '.?submodules=1' "${develop_args[@]}" \
            --command env NIX_CONFIG_DEV_SHELL=1 SWITCH_HM_DEV_SHELL_REEXEC=1 \
            bash -c 'cd -- "$1" || exit; shift; exec "$@"' switch-hm \
            "$caller_cwd" "$script" "${original_args[@]}"
    fi
    if [[ -n "$target" ]]; then
        switch_remote "$target" "$host" "$username" "$use_remote_sudo" "$dry_run" "${NIX_SSHOPTS-}" "$do_rekey" "${hm_args[@]}"
        [[ "$dry_run" == false ]] || return 0
    else
        [[ -n "$host" ]] || host="$(hostname -s)"
        [[ -n "$username" ]] || username="$(id -un)"
        [[ "$host" =~ ^[[:alnum:]_][[:alnum:]_.-]*$ ]] || fail 'invalid hostname'
        [[ "$username" =~ ^[[:alnum:]_][[:alnum:]_.-]*$ ]] || fail 'invalid username'
        local arch
        arch="$(configuration_arch "$(uname -m)" "$(uname -s)")"
        stage_changes
        if [[ "$do_rekey" == true ]]; then
            run_rekey_home "${username}@${host}-${arch}" "${hm_args[@]}"
        fi
        nix --extra-experimental-features 'nix-command flakes' run \
            '.?submodules=1#home-manager-cli' -- \
            switch -b hmbak --flake ".?submodules=1#${username}@${host}-${arch}" "${hm_args[@]}"
    fi

    if [[ "$do_git" == true ]]; then
        # Pass the message as data, never as shell text interpolated by foreach.
        SWITCH_HM_COMMIT_MESSAGE="$message" git submodule foreach '
            git add -A || exit "$?"
            if git diff --cached --quiet; then
                :
            else
                status=$?
                [ "$status" -eq 1 ] || exit "$status"
                git commit -m "$SWITCH_HM_COMMIT_MESSAGE" || exit "$?"
            fi
        '
        commit_changes "$message"
        if [[ "$do_push" == true ]]; then
            git push --recurse-submodules=on-demand
        fi
    fi
}

main "$@"
